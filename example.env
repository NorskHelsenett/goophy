# Goophy Configuration File
# This is an example .env file. You can use this as a template.

# Port number to listen on
PORT=22434

# Target API endpoint to forward requests to. Leave unset to proxy to the
# gateway you are logged in to (goophy login); setting it, or API_KEY,
# makes goophy ignore that login.
# API_ENDPOINT=http://localhost:11434

# Optional API key for authentication
# API_KEY=your_secret_api_key_here

# Auto-update settings
# DISABLE_AUTO_UPDATE=true
# UPDATE_CHECK_INTERVAL=12h
